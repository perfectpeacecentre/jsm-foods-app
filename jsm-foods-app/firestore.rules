rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true;
    }
    function isManager() {
      return isActive() && profile().role in ['admin', 'owner'];
    }

    // Staff profiles: role + active flag. Users can read their own; admin/owner manage all.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow create, update: if isManager();
      allow delete: if false;
    }

    // Customer records: any active user can add. Reps edit their own entries.
    // Admin/owner can edit or delete anything.
    match /customers/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ['Distributor', 'Bakery']
        && request.resource.data.status in ['Current', 'Prospective', 'Former', 'Not interested'];
      allow update: if isManager()
        || (isActive() && resource.data.createdBy == request.auth.uid);
      allow delete: if isManager();
    }
  }
}
